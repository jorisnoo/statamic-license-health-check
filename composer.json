{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jorisnoo/statamic-license-health-check",
    "description": "Monitor Statamic license validity without alerting on temporary Outpost outages.",
    "type": "statamic-addon",
    "license": "MIT",
    "homepage": "https://github.com/jorisnoo/statamic-license-health-check",
    "keywords": [
        "statamic",
        "statamic-addon",
        "health-check",
        "monitoring",
        "oh-dear"
    ],
    "authors": [
        {
            "name": "Joris Noordermeer",
            "email": "contact@noordermeer.ch",
            "homepage": "https://github.com/jorisnoo"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-health": "^1.40",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Noo\\StatamicLicenseHealthCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noo\\StatamicLicenseHealthCheck\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noo\\StatamicLicenseHealthCheck\\ServiceProvider"
            ]
        },
        "statamic": {
            "name": "License Health Check",
            "description": "Monitor Statamic license validity without false alerts during Outpost outages."
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
